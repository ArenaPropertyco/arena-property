# Supabase (RT-04). En local salen de `supabase start`.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=

# Sitio público (@nuxtjs/seo). Sin dominio real se deja vacío.
NUXT_PUBLIC_SITE_URL=

# Analítica del embudo público (nuxt-gtag, HU-00)
NUXT_PUBLIC_GTAG_ID=

# Clave de servicio (solo servidor; nunca con prefijo NUXT_PUBLIC_). En local sale de `supabase status`.
NUXT_SUPABASE_SECRET_KEY=

# Google OAuth (HU-61). Las lee la CLI de Supabase, no Nuxt: van en supabase/config.toml
# vía env(), nunca hardcodeadas. Salen de Google Cloud Console → credencial "Web application".
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
