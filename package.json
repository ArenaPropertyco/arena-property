{
  "name": "arena-property",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "tsc --build tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > shared/types/database.types.ts",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "trace": "node scripts/trazabilidad.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:db:sql": "supabase test db"
  },
  "dependencies": {
    "@formkit/auto-animate": "0.10.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.11.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "5.3.14",
    "@nuxtjs/supabase": "2.0.10",
    "@tresjs/nuxt": "5.6.3",
    "@unovis/ts": "1.6.7",
    "@unovis/vue": "1.6.7",
    "motion-v": "2.4.0",
    "nuxt": "4.5.2",
    "nuxt-aos": "1.2.6",
    "nuxt-gtag": "5.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.2.0",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.9.1",
    "happy-dom": "20.12.2",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
